# Copy this file to `.env` and fill in real values. Never commit `.env`.
# All settings below are REQUIRED — the service refuses to start without them.

# MongoDB connection string, including the database name. Point this at a
# database whose name ends in `_test` when running the test suite or
# rehearsal — see implementation/RUNBOOK.md. NEVER point it at the production
# database while running tests, `prepare`, or `rehearsal.py`.
MONGODB_URI=mongodb://localhost:27017/cognitest_demo

# HS256 signing secret for demo student JWTs. Must be at least 32 bytes.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long

# The institute this deployment serves. Must match the `instituteId` in every
# manifest.json you prepare, and must be a valid 24-hex MongoDB ObjectId.
INSTITUTE_ID=60c72b2f9b1e8a001c8e4a5d

# Exact allowlist of browser origins permitted to call the demo API, as a
# JSON array of strings (pydantic-settings parses this as JSON).
ALLOWED_ORIGINS=["http://localhost:5173"]

# --- Optional settings (defaults shown) ---

# Set to false ONLY for local plain-HTTP development. Must be true wherever
# the service is reachable over anything but localhost.
# COOKIE_SECURE=true

# Number of trusted reverse-proxy hops in front of this service. Leave at 0
# unless a verified reverse proxy sets X-Forwarded-For correctly.
# TRUSTED_PROXY_COUNT=0
