# Copy this file to `.env` (or `.env.local`) to run the frontend in demo
# mode. Never commit `.env`/`.env.local`.

# When "true": the /student subtree renders the demo analysis flow
# (DemoStudentLayout/DemoReports/DemoReportDetail/DemoActivate) via the
# FastAPI analysis_service at /api/v2/demo/*, instead of the legacy
# Express-backed StudentLayout/Reports/StudentSignup flow. See
# implementation/RUNBOOK.md for how to run analysis_service locally.
VITE_USE_DEMO=true
